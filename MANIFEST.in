include README.md
include CHANGELOG.md
include license
include pyproject.toml
include requirements.txt

recursive-include src/DeepGPR *.py *.typed *.cu *.h *.c *.dll *.so *.dylib

# Exclude local state and repository-only resources.
prune .*
prune validation
prune Fig
prune docs
prune examples
prune scripts
prune tests
prune tools
prune website

global-exclude .DS_Store
global-exclude *.py[cod]
global-exclude __pycache__
